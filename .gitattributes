# Normalise to LF in the repository. Shell scripts and the nginx/systemd units are executed on
# Linux; a CRLF checkout makes bash fail with "\r: command not found", so pin them explicitly.
* text=auto

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.kts       text eol=lf
*.kt        text eol=lf
*.toml      text eol=lf
*.properties text eol=lf
gradlew     text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf

*.png binary
*.jpg binary
*.keystore binary
*.jks binary
