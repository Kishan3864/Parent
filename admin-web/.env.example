# Origin prefix of the ParentalTrack API, WITHOUT the /v1 version segment.
# The API layer appends "/v1/..." itself, e.g. "/api" + "/v1/devices" -> "/api/v1/devices".
#
# Development: leave as /api so the Vite dev server proxies to http://localhost:5080.
# Production:  point at the deployed API, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api
