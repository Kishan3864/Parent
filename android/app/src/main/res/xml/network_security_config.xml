<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is refused everywhere except the two loopback hosts a developer machine uses:
  10.0.2.2 (the Android emulator's alias for the host) and localhost/127.0.0.1.

  Release builds additionally set android:usesCleartextTraffic="false" and
  BuildConfig.ALLOW_CLEARTEXT=false, and point BuildConfig.API_BASE_URL at an https:// origin,
  so the loopback exception below is unreachable in a release build. Delete the <domain-config>
  block if you want the exception gone from the shipped APK as well.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
